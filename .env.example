# Database (Vercel Postgres / Neon). Use non-pooling URL for Payload.
DATABASE_URL=postgres://kcdgujarat:kcdgujarat@localhost:5432/kcdgujarat
POSTGRES_URL_NON_POOLING=postgres://kcdgujarat:kcdgujarat@localhost:5432/kcdgujarat

# Payload
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Media (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Revalidation
REVALIDATE_SECRET=replace-with-32-byte-random

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REGISTRATION_URL=https://example.com/register
NEXT_PUBLIC_CFP_URL=https://sessionize.com/kcd-gujarat-2026
# When "true", only / is served (coming-soon page); all other routes return 404.
NEXT_PUBLIC_COMING_SOON=false

# Email (Resend, optional)
RESEND_API_KEY=
