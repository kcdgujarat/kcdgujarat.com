# Dev image — hot reload via bind mount + polling watcher.
# pnpm install runs at container start (see docker-compose command) so deps
# always track the current package.json/lockfile, not a stale image layer.
FROM node:20-bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:/usr/local/bin:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    CHOKIDAR_USEPOLLING=true \
    WATCHPACK_POLLING=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true

# Native deps (sharp etc.) need build tools. dumb-init for clean PID 1.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        openssl \
        dumb-init \
        python3 \
        make \
        g++ \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

EXPOSE 3000

ENTRYPOINT ["dumb-init", "--"]
CMD ["pnpm", "dev"]
